{
	"name": "@marianmeres/ws",
	"version": "0.4.1",
	"exports": {
		".": "./src/mod.ts",
		"./server": "./src/server.ts",
		"./protocol": "./src/protocol.ts"
	},
	"tasks": {
		"test": "deno test -A",
		"test:watch": "deno test -A --watch",
		"example": "deno task example:build && deno run -A example/server.ts",
		"example:build": "deno run -A jsr:@marianmeres/deno-build --root example/client --outdir example/public/dist",
		"example:watch": "deno run -A jsr:@marianmeres/deno-build --root example/client --outdir example/public/dist --watch --watch-dir src --watch-dir example",
		"example:styles": "deno run -A example/build-styles.ts",
		"npm:build": "deno run -A scripts/build-npm.ts",
		"npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
		"release": "deno run -A jsr:@marianmeres/release",
		"publish": "deno publish && deno task npm:publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish"
	},
	"imports": {
		"@marianmeres/clog": "jsr:@marianmeres/clog@^3.21.0",
		"@marianmeres/demino": "jsr:@marianmeres/demino@^1.17.0",
		"@marianmeres/design-tokens": "jsr:@marianmeres/design-tokens@^1.20.0",
		"@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1.16.0",
		"@marianmeres/pubsub": "jsr:@marianmeres/pubsub@^3.0.0",
		"@marianmeres/ticker": "jsr:@marianmeres/ticker@^1.17.1",
		"@marianmeres/uid": "jsr:@marianmeres/uid@^1.2.0",
		"@marianmeres/vanilla": "jsr:@marianmeres/vanilla@^1.10.0",
		"@marianmeres/vanilla-ui": "jsr:@marianmeres/vanilla-ui@^0.5.2",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/path": "jsr:@std/path@^1.1.6"
	},
	"publish": {
		"exclude": [
			".*",
			"tests/**",
			"tmp/**",
			"example/**"
		]
	},
	"exclude": [
		"example/public/dist",
		"example/public/reboot.css",
		"example/public/theme.css",
		"example/public/vui-base.css"
	],
	"minimumDependencyAge": {
		"exclude": [
			"jsr:@marianmeres/*",
			"npm:@marianmeres/*"
		]
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve"
	}
}
