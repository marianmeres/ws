{
  "name": "@marianmeres/ws",
  "exports": {
    ".": "./src/mod.ts",
    "./server": "./src/server.ts",
    "./protocol": "./src/protocol.ts"
  },
  "nodeModulesDir": "none",
  "minimumDependencyAge": {
    "exclude": ["jsr:@marianmeres/*", "npm:@marianmeres/*"]
  },
  "exclude": ["node_modules", "dist", "example"],
  "imports": {
    "@marianmeres/clog": "jsr:@marianmeres/clog@^3.21.0",
    "@marianmeres/demino": "jsr:@marianmeres/demino@^2.0.0",
    "@marianmeres/pubsub": "jsr:@marianmeres/pubsub@^3.0.0",
    "@marianmeres/ticker": "jsr:@marianmeres/ticker@^1.17.1",
    "@marianmeres/uid": "jsr:@marianmeres/uid@^1.2.0"
  },
  "publish": {
    "exclude": [
      ".*",
      "dist/**",
      "example/**",
      "scripts/**",
      "tests/**",
      "tmp/**",
      "biome.json",
      "deno.lock",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json",
      "tsconfig.build.json"
    ]
  }
}
