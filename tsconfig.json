{
	// Editor + `pnpm run typecheck` view: src, tests and example, no output. Node runs the
	// source with its types stripped and never checks them, so this is the type gate.
	"compilerOptions": {
		"target": "es2024",
		// "dom": the client runs in the browser (WebSocket, location, document);
		// "esnext.disposable": unsubscribers carry Symbol.dispose, for `using`. Deno
		// reads this file too (`deno publish` type-checks with it) and, unlike tsc,
		// does not get Symbol.dispose from @types/node.
		"lib": ["es2024", "esnext.disposable", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],

		"strict": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,

		// erasable-only TS: what Node's type stripping can run unchanged
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		// imports keep their `.ts` extension in source; tsc rewrites them to `.js` on emit
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,

		"noEmit": true
	},
	"include": ["src", "tests", "example"],
	"exclude": ["example/public"]
}
